<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <application android:name="com.zsz.studyassistant.IntegrationTestApplication"
        android:label="StudyAssistant Integration Tests" tools:replace="android:name,android:label">
        <activity android:name="com.zsz.studyassistant.ui.UpdatePageTestActivity" android:exported="false" />
        <receiver android:name="com.zsz.studyassistant.data.ReminderReceiver" tools:node="remove" />
        <service android:name="com.zsz.studyassistant.data.AnswerForegroundService" tools:node="remove" />
        <!-- Use the real narrow FileProvider for synthetic system-camera output tests. -->
        <provider android:name="com.zsz.studyassistant.data.TestBackupDocumentsProvider"
            android:authorities="${applicationId}.fixture.backups" android:exported="true"
            android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
    </application>
</manifest>
